<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SupportDesk.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SupportDesk.Presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SupportDesk.Presentation"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Ärenden"
                    Icon="Home"
                    Tag="SupportTicketOverview" />
                <NavigationViewItem
                    Content="Kunder"
                    Icon="People"
                    Tag="Customers" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="PostUpdate"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="Tag"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="List"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="Document"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="Mail"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="PostUpdate"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="Comment"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="Flag"
                    Tag="CreateSupportTicket" />
                <NavigationViewItem
                    Content="Skapa ärende"
                    Icon="Help"
                    Tag="CreateSupportTicket" />
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
