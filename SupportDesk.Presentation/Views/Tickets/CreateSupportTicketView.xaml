<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.Tickets.CreateSupportTicketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Views.Tickets"
    xmlns:vm="using:SupportDesk.Presentation.ViewModels.Tickets"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    
    >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="LightBlue">
            <!-- vänsterkolumnen input med knappar -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Skapa Supportärende" HorizontalAlignment="Center" Padding="20"/>
                <TextBox Header="Rubrik:" PlaceholderText="Skriv in Rubrik" Grid.Row="1" 
						 Text="{x:Bind ViewModel.Title, Mode=TwoWay}" HorizontalAlignment="Left" Margin="20"
				         Width="260" Height="100" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <TextBox Grid.Row="2" Header="Beskrivning:" PlaceholderText="Beskriv felet" 
						 Text="{x:Bind ViewModel.Description, Mode=TwoWay}" HorizontalAlignment="Left" 
				         Margin="20" Height="200" Width="260" TextWrapping="Wrap" AcceptsReturn="True"
				         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                <TextBlock Grid.Row="3" Text="Välj ärendets prioritetsnivå:" Margin="20" />
                <ComboBox Grid.Row="4" Margin="30" Padding="10" HorizontalAlignment="Left" Width="150" 
                          ItemsSource="{x:Bind ViewModel.Priorities}" SelectedItem="{x:Bind ViewModel.TicketPriority, Mode=TwoWay}">
                </ComboBox>
                <Button Grid.Row="5" Content="Skapa Ärende." Margin="20" Padding="10" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.UICreateTicketCommand}"/>


            </Grid>
        </Border>
        <Border Grid.Column="1" Background="LightBlue">
            <!-- mittenkolumnen input med knappar-->
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="Välj vilken kund ärendet gäller från listan:" Margin="10,0,0,10" HorizontalAlignment="Center"/>
                <ListView ItemsSource="{x:Bind ViewModel.Customers}" SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}" 
                          Background="Gray" BorderThickness="2" 
                          BorderBrush="Black" Width="350" Height="600" 
                          HorizontalAlignment="Center"  />
                
            </StackPanel>
            
        </Border>
        <Border Grid.Column="2" Background="CadetBlue">
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Margin="20" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                <!-- högerkolumnen input med knappar -->
                <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Margin="20" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Center"/>

            </StackPanel>
            
        </Border>
    </Grid>
</Page>
