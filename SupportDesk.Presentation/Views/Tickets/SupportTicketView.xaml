<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SupportDesk.Presentation.Views.Tickets.SupportTicketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SupportDesk.Presentation.Views.Tickets"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tickets="using:SupportDesk.Domain.Tickets"
	xmlns:helpers="using:SupportDesk.Presentation.Helpers"
    mc:Ignorable="d">

	<!--för mindre opacity på placeholder-text-->

	<Page.Resources>
		<SolidColorBrush
            x:Key="PlaceholderBrush"
            Opacity="0.4"
            Color="{ThemeResource TextFillColorSecondary}" />
	</Page.Resources>

	<Grid Padding="24,0,24,24">
		<Grid.RowDefinitions>
			<RowDefinition Height="124" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Ticket status summary  -->

		<Grid
            Grid.Row="0"
            Margin="16"
            ColumnSpacing="24">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Border
                Grid.Column="1"
                Padding="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">

				<StackPanel
                    Orientation="Horizontal"
                    Spacing="16">

					<StackPanel Spacing="6">
						<TextBlock
                            HorizontalAlignment="Center"
                            Text="Nytt" />

						<Border
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="4">

							<TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.NewCount, Mode=OneWay}" />
						</Border>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock
                            HorizontalAlignment="Center"
                            Text="Pågående" />

						<Border
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="4">

							<TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.InProgressCount, Mode=OneWay}" />
						</Border>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock
                            HorizontalAlignment="Center"
                            Text="Löst" />

						<Border
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="4">

							<TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.ResolvedCount, Mode=OneWay}" />
						</Border>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!--  Heading  -->

		<StackPanel
            Grid.Row="1"
            Margin="0,0,0,12">
			<TextBlock
                Padding="0,0,0,10"
                FontSize="28"
                FontWeight="Bold"
                Text="Supportärenden" />
			<StackPanel
                Orientation="Horizontal"
                Spacing="12">
				<Button
                    Click="OpenTicketButton_Click"
                    Content="Öppna markerat ärende"
                    Style="{StaticResource AccentButtonStyle}" />

				<Button
                    Click="CreateTicketButton_Click"
                    Content="Skapa ett ärende" />

				<Button
                    x:Name="CustomerViewButton"
                    MinWidth="120"
                    Margin="20,0,0,0"
                    Click="CustomerViewButton_Click"
                    Content="Kunder" />

			</StackPanel>
		</StackPanel>

		<!--  Search & Filter  -->

		<Grid
            Grid.Row="2"
            Margin="0,0,0,12"
            ColumnSpacing="12">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!--  Search bar  -->

			<TextBox
                Grid.Column="0"
				PlaceholderForeground="{StaticResource PlaceholderBrush}"
                PlaceholderText="Sök efter ärenderubrik eller kundnamn"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<!--  Status filter  -->

			<ComboBox
                Grid.Column="1"
                MinWidth="160"
                ItemsSource="{x:Bind ViewModel.StatusFilters}"
                SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}" />

		</Grid>

		<!--  Ticket list  -->

		<ListView
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Tickets}"
            SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=TwoWay}"
            SelectionMode="Single">
			<ListView.ItemContainerStyle>
				<Style
                    BasedOn="{StaticResource DefaultListViewItemStyle}"
                    TargetType="ListViewItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
					<Setter Property="CornerRadius" Value="8" />
					<Setter Property="Margin" Value="0,0,0,12" />
					<Setter Property="Padding" Value="12" />
				</Style>
			</ListView.ItemContainerStyle>
			<ListView.ItemTemplate>

				<DataTemplate x:DataType="tickets:SupportTicket">
					<Grid
                        Padding="8"
                        ColumnDefinitions="*, Auto"
						ColumnSpacing="16">
						<StackPanel
                            Grid.Column="0"
                            Spacing="4">
							<TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{x:Bind Title}" />
							<TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}" />
							<TextBlock
                                FontSize="12"
                                Text="{x:Bind CreatedAt}" />
						</StackPanel>

						<StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Spacing="6">
							<Border
								Padding="10,2"
								HorizontalAlignment="Right"
								Background="{x:Bind helpers:TicketDisplay.StatusBrush(Status)}"
								CornerRadius="10">
								<TextBlock
									FontSize="12"
									Foreground="White"
									Text="{x:Bind helpers:TicketDisplay.StatusText(Status)}" />
							</Border>
							<Border
							Padding="10,2"
							HorizontalAlignment="Right"
							Background="{x:Bind helpers:TicketDisplay.PriorityBrush(Priority)}"
							CornerRadius="10">
								<TextBlock
									FontSize="12"
									Foreground="White"
									Text="{x:Bind helpers:TicketDisplay.PriorityText(Priority)}" />
							</Border>
							<Border
								Padding="10,2"
								HorizontalAlignment="Right"
								Background="{ThemeResource ControlFillColorDefaultBrush}"
								BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="10"
								Visibility="{x:Bind helpers:TicketDisplay.VisibleIfNotEmpty(AssignedTechnician)}">
								<StackPanel
									Orientation="Horizontal"
									Spacing="6">
									<FontIcon
										FontFamily="Segoe Fluent Icons"
										FontSize="12"
										Glyph="&#xE77B;" />
									<TextBlock
										FontSize="12"
										Text="{x:Bind AssignedTechnician}" />
								</StackPanel>
							</Border>


							<Button
								Padding="8,2"
								HorizontalAlignment="Right"
								Style="{StaticResource SubtleButtonStyle}"
								Tag="{x:Bind}">
  
								<StackPanel
									Orientation="Horizontal"
									Spacing="6">
									<SymbolIcon Symbol="Comment" />
									<TextBlock
										FontSize="12"
										Text="{x:Bind Comments.Count}" />
								</StackPanel>

								<Button.Flyout>
									<Flyout>
										<StackPanel
											Width="300"
											Spacing="8">
											<TextBox
												MinHeight="80"
												AcceptsReturn="True"
												PlaceholderText="Skriv en kommentar..."
												TextWrapping="Wrap" />
											<Button
												HorizontalAlignment="Right"
												Click="QuickCommentButton_Click"
												Content="Lägg till"
												Style="{StaticResource AccentButtonStyle}"
												Tag="{x:Bind}" />
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
						</StackPanel>

					</Grid>

				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</Page>
