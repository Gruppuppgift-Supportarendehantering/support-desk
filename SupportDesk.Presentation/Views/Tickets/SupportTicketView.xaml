<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SupportDesk.Presentation.Views.Tickets.SupportTicketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SupportDesk.Presentation.Views.Tickets"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tickets="using:SupportDesk.Domain.Tickets"
    mc:Ignorable="d">

    <Grid Padding="24,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12">
            <TextBlock
                Padding="0,0,0,10"
                FontSize="28"
                FontWeight="Bold"
                Text="Supportärenden" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Click="OpenTicketButton_Click"
                    Content="Öppna markerat ärende"
                    Style="{StaticResource AccentButtonStyle}" />

                <Button
                    Click="CreateTicketButton_Click"
                    Content="Skapa ett ärende" />

                <Button
                    x:Name="CustomerViewButton"
                    MinWidth="120"
                    Margin="20,0,0,0"
                    Click="CustomerViewButton_Click"
                    Content="Kunder" />

            </StackPanel>
        </StackPanel>

        <ListView
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Tickets}"
            SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style
                    BasedOn="{StaticResource DefaultListViewItemStyle}"
                    TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Setter Property="Padding" Value="12" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="tickets:SupportTicket">
                    <Grid 
                        Padding="8"
                        ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}" />
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind CreatedAt}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind Status}" />
                            <TextBlock Text="{x:Bind Priority}" />
                            <TextBlock Text="{x:Bind AssignedTechnician}" />
                        </StackPanel>
                    </Grid>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
