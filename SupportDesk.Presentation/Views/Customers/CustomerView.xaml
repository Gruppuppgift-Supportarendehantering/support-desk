<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SupportDesk.Presentation.Views.Customers.CustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:SupportDesk.Application.Dtos.Customers"
    xmlns:local="using:SupportDesk.Presentation.Views.Customers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="0,0,0,12"
            VerticalAlignment="Top">
            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.GoBackCommand}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE72B;" />
            </Button>

            <!--  Message  -->

            <Border
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">

                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Spacing="12">

            <!--  Heading  -->

            <TextBlock
                FontSize="28"
                Text="Kunder" />

            <!--  Buttons  -->

            <StackPanel
                Orientation="Horizontal"
                Spacing="16">
                <StackPanel Spacing="4">
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CreateCustomerCommand}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE710;" />
                    </Button>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="Lägg till" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.EditCustomerCommand}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE70F;" />
                    </Button>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="Redigera" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Button
                        HorizontalAlignment="Center"
                        Click="DeleteCustomer_Click">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE74D;" />
                    </Button>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="Radera" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  Customer List  -->

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Customers}"
            SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
            SelectionMode="Single">

            <ListView.ItemContainerStyle>
                <Style
                    BasedOn="{StaticResource DefaultListViewItemStyle}"
                    TargetType="ListViewItem">

                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Setter Property="Padding" Value="12" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dto:CustomerData">
                    <Grid
                        Padding="8"
                        ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind CustomerName}" />
                            <TextBlock Text="{x:Bind EmailAddress}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind CustomerTypeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
