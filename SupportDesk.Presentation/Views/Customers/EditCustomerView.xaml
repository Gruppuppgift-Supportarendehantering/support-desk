<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.Customers.EditCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Views.Customers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Padding="24" MaxWidth="500">
        <TextBlock Text="Redigera kund" FontSize="28" />

        <TextBox
            Header="Kundnamn"
            Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, 
            UpdateSourceTrigger=PropertyChanged}" />
        
        <TextBox
            Header="E-postadress"
            Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay,
            UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            TextWrapping="Wrap" />

        <Button
            Content="Tillbaka"
            Command="{x:Bind ViewModel.GoBackCommand}" />

        <Button
            Content="Spara ändring"
            Command="{x:Bind ViewModel.UpdateCommand}" />
    </StackPanel>
</Page>
