<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SupportDesk.Presentation.Views.Customers.EditCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SupportDesk.Presentation.Views.Customers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="0,0,0,12"
            VerticalAlignment="Top">
            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.GoBackCommand}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE72B;" />
            </Button>

            <!--  Message  -->

            <Border
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasMessage, Mode=OneWay}">

                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="1"
            MaxWidth="500"
            Padding="24,0,24,24"
            Spacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="28"
                Text="Redigera kund" />

            <TextBox
                Header="Kundnamn"
                PlaceholderText="Namn"
                Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                Header="E-postadress"
                PlaceholderText="namn@exempel.se"
                Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.UpdateCommand}"
                Content="Spara ändringar"
                Style="{StaticResource ActionButton}" />

        </StackPanel>
    </Grid>
</Page>
