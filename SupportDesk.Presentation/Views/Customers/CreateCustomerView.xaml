<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.Customers.CreateCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Views.Customers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Padding="24" MaxWidth="500">
        <TextBlock Text="Lägg till kund" FontSize="28" />
        
        <TextBox 
            Header="Kundnamn"
            PlaceholderText="Ange namn"
            Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay,
            UpdateSourceTrigger=PropertyChanged}" />

        <TextBox 
            Header="E-postadress"
            PlaceholderText="Ange e-postadress"
            Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay,
            UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Spacing="8">
            <TextBlock Text="Kundtyp" />

            <Border
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton
                        Grid.Column="0"
                        Content="Privatkund"
                        GroupName="CustomerType"
                        IsChecked="True"
                        HorizontalAlignment="Stretch"
                        CornerRadius="7,0,0,7"
                        Style="{StaticResource SegmentedSwitch}" />

                    <RadioButton
                        Grid.Column="1"
                        Content="Företagskund"
                        GroupName="CustomerType"
                        IsChecked="{x:Bind ViewModel.IsCompany, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        CornerRadius="0,7,7,0"
                        Style="{StaticResource SegmentedSwitch}" />
                </Grid>
            </Border>
        </StackPanel>
        
        <TextBlock
            Text="{x:Bind ViewModel.Message, Mode=OneWay}"
            TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                Spacing="4">
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.GoBackCommand}">
                    <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE72B;" />
                </Button>


                <TextBlock
                    Text="Tillbaka"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Spacing="4">
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.SaveCommand}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE74E;" />
                </Button>

                <TextBlock
                    Text="Lägg till"
                    HorizontalAlignment="Center" />
            </StackPanel>


        </Grid>

    </StackPanel>
    
</Page>
