<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="SupportDesk.Presentation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SupportDesk.Presentation.Helpers"
    xmlns:local="using:SupportDesk.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/SegmentedSwitch.xaml" />
                <ResourceDictionary Source="/Styles/ActionButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:EnumTextConverter x:Key="EnumTextConverter" />

            <DataTemplate x:Key="EnumTextTemplate">
                <TextBlock Text="{Binding Converter={StaticResource EnumTextConverter}}" />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
